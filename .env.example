# Required for Sanity content reads
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Optional; defaults to production in code
# NEXT_PUBLIC_SANITY_DATASET=production

# Optional; only needed for draft/preview reads
SANITY_API_READ_TOKEN=

# Required to send contact-form emails
RESEND_API_KEY=
RESEND_FROM_EMAIL="Core Communications <contact@example.com>"

# Optional; falls back to SITE.email in app constants
# CONTACT_EMAIL_TO=contact@example.com

# Optional; set both values to enable Turnstile validation
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET=

# Recommended in production; optional locally
NEXT_PUBLIC_SITE_URL=https://www.corecommunication.biz

# Optional site-verification tags
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Required only if webhook/on-demand revalidation is enabled
REVALIDATE_SECRET=

# Optional; enables durable cross-instance rate limiting
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional; enables Vercel Edge Config feature flags
# EDGE_CONFIG=

# Optional studio-specific overrides
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=

# Currently unused in app runtime; add only if future tooling needs it
# SANITY_API_TOKEN=
